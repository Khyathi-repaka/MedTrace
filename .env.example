# Copy to .env and fill in real values. Never commit .env.

# --- Database (Postgres — Supabase/Neon/local all work) ---
DATABASE_URL=postgresql+psycopg2://medtrace:medtrace@localhost:5432/medtrace

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- AI provider: openai | gemini | demo ---
# "demo" runs without any external key (see ai/providers/demo_provider.py) so
# the pipeline is testable without live credentials. Set a real provider +
# key for actual LLM-grounded extraction/answers.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_data

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
